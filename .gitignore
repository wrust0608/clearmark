# Deny by default: only what is explicitly allowed below can be added to git.
# Local test artifacts, secrets (.env), and tooling stay out without a rule
# for each one. Tracked files are unaffected.
/*
!/.claude-plugin/
!/.claude-plugin/**
!/hooks/
!/hooks/**
!/.github/
!/.github/**
!/benchmarks/
!/benchmarks/**
!/config/
!/config/**
!/docs/
!/docs/**
!/service/
!/service/**
!/skills/remove-ai-marks/
!/skills/remove-ai-marks/**
!/skills/clean-user-facing-text/
!/skills/clean-user-facing-text/**
!/tests/
!/tests/**
!/.coderabbit.yaml
!/.dockerignore
!/.env.example
!/.gitignore
!/.pre-commit-hooks.yaml
!/CODE_OF_CONDUCT.md
!/compose-check.sh
!/compose.yaml
!/CONTRIBUTING.md
!/LICENSE
!/Makefile
!/pytest.ini
!/README.md
!/requirements-dev.txt
!/ruff.toml
!/SECURITY.md
!/ClearMark.cmd
!/Open-ClearMark.cmd
!/Stop-ClearMark.cmd
!/assets/
!/assets/**
!/clearmark-manager.ps1
!/start-app.ps1
!/stealer/
!/stealer/**
!/tools/
!/tools/**
!/00_REVIEW_SUMMARY.md
!/RELEASE_NOTES.md
!/MASTER_IMPLEMENTATION_PLAN.md
!/CLEANUP_PLAN.md
!/manifests/
!/manifests/**
!/01_GOLDEN_ORIGINAL_UNTOUCHED.docx
!/02_BAD_OUTPUT_RUN_EXPLOSION.docx
!/03_INTERMEDIATE_OUTPUT_LAYOUT_REGRESSION.docx
!/04_CANDIDATE_LOSSLESS_OUTPUT.docx
!/WATERMARK_DOCX_3_BASELINES.zip
!/artifacts/
/artifacts/*
!/artifacts/v2.1/
!/artifacts/v2.1/**

# Exceptions even inside allowed trees
.env
**/__pycache__/
*.pyc
# The stealer's downloaded prompt corpus is generated data, not source.
stealer/prompts/
stealer/prompts/**
.venv/
.firecrawl/
.figlet/
posts.md
*.cleaned.*
*.bak
